{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "ai-knowledge-assistant",
    "Audience": "ai-knowledge-assistant-api",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AI": {
    "Provider": "Ollama",
    "ApiKey": "",
    "Endpoint": "",
    "Model": "local-rag",
    "EmbeddingModel": "local-hash-embedding"
  },
  "Storage": {
    "UploadsPath": "uploads"
  },
  "RateLimiting": {
    "Chat": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
