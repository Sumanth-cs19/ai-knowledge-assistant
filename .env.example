ASPNETCORE_ENVIRONMENT=Development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=AIKnowledgeAssistant
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AIKnowledgeAssistant;Username=postgres;Password=your-postgres-password
JWT_ISSUER=ai-knowledge-assistant
JWT_AUDIENCE=ai-knowledge-assistant-api
JWT_SIGNING_KEY=replace-with-a-long-random-development-secret
Jwt__Issuer=ai-knowledge-assistant
Jwt__Audience=ai-knowledge-assistant-api
Jwt__SigningKey=replace-with-a-long-random-development-secret
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
AI_PROVIDER=Ollama
AI_API_KEY=
AI_ENDPOINT=http://localhost:11434
AI_MODEL=llama3.1
AI_EMBEDDING_MODEL=nomic-embed-text
AI__Provider=Ollama
AI__ApiKey=
AI__Endpoint=http://localhost:11434
AI__Model=llama3.1
AI__EmbeddingModel=nomic-embed-text
Storage__UploadsPath=uploads
